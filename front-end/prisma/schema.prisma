generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// DO NOT CHANGE MIGRATION MODEL!
model Migration {
  id         Int    @id @default(autoincrement())
  name       String
  created_at Int
}

model User {
  id                      String                    @id @default(uuid())
  email                   String                    @unique
  password                String
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @updatedAt
  keysPairs               KeyPair[]
  transactions            Transaction[]
  organizationCredentials OrganizationCredentials[]
  HederaAccount           HederaAccount[]
  HederaFile              HederaFile[]
  TransactionDraft        TransactionDraft[]
  ComplexKey              ComplexKey[]
  Contact                 Contact[]
  Claim                   Claim[]
  Mnemonic                Mnemonic[]
  SmartContract           SmartContract[]
}

model KeyPair {
  id                   String        @id @default(uuid())
  user_id              String
  index                Int
  public_key           String
  private_key          String
  type                 String
  organization_id      String?
  organization_user_id Int?
  secret_hash          String?
  nickname             String?
  user                 User          @relation(fields: [user_id], references: [id])
  organization         Organization? @relation(fields: [organization_id], references: [id])
}

model Organization {
  id        String @id @default(uuid())
  nickname  String
  serverUrl String
  key       String

  keyPairs                KeyPair[]
  OrganizationCredentials OrganizationCredentials[]
  Contact                 Contact[]
  ReviewerGroup           ReviewerGroup[]
}

model OrganizationCredentials {
  id                   String       @id @default(uuid())
  email                String
  password             String
  organization_id      String
  organization_user_id Int?
  user_id              String
  jwtToken             String?
  updated_at           DateTime?    @updatedAt
  user                 User         @relation(fields: [user_id], references: [id])
  organization         Organization @relation(fields: [organization_id], references: [id])
}

model Transaction {
  id                 String   @id @default(uuid())
  name               String
  type               String
  description        String
  transaction_id     String
  transaction_hash   String
  body               String
  status             String
  status_code        Int
  user_id            String
  signature          String
  valid_start        String
  executed_at        Int
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  group_id           String?
  creator_public_key String?
  network            String
  user               User     @relation(fields: [user_id], references: [id])

  GroupItem GroupItem[]
}

model TransactionDraft {
  id               String   @id @default(uuid())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  user_id          String
  type             String
  transactionBytes String
  description      String
  isTemplate       Boolean? @default(false)
  details          String?
  user             User     @relation(fields: [user_id], references: [id])

  GroupItem GroupItem[]
}

model HederaAccount {
  id         String   @id @default(uuid())
  user_id    String
  account_id String
  nickname   String?
  network    String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model HederaFile {
  id            String    @id @default(uuid())
  user_id       String
  file_id       String
  network       String
  created_at    DateTime  @default(now())
  nickname      String?
  description   String?
  metaBytes     String?
  contentBytes  String?
  lastRefreshed DateTime?
  user          User      @relation(fields: [user_id], references: [id])
}

// `abi` is the normalized function-array ABI (post upload format-sniffing), stored as a JSON
// string rather than Prisma's Json type, matching this schema's existing convention for JSON
// columns. `roles` is local bookkeeping only — never derived from or verified against the
// chain beyond the one-time getter resolution that may populate a role's `value`. There is
// deliberately no function-to-role mapping: a function can require more than one role and a
// role can have more than one holder, so the registry only surfaces roles and functions as
// discovered info rather than pretending to model that mapping.
model SmartContract {
  id          String   @id @default(uuid())
  user_id     String
  network     String
  contract_id String?
  evm_address String?
  nickname    String?
  abi         String
  roles       String?
  verified    Boolean  @default(false)
  created_at  DateTime @default(now())
  user        User     @relation(fields: [user_id], references: [id])
}

model ComplexKey {
  id              String   @id @default(uuid())
  user_id         String
  nickname        String
  protobufEncoded String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  user            User     @relation(fields: [user_id], references: [id])
}

model Contact {
  id                         String       @id @default(uuid())
  user_id                    String
  organization_user_id_owner Int
  organization_user_id       Int
  organization_id            String
  nickname                   String
  user                       User         @relation(fields: [user_id], references: [id])
  organization               Organization @relation(fields: [organization_id], references: [id])
}

model TransactionGroup {
  id              String   @id @default(uuid())
  description     String
  atomic          Boolean
  created_at      DateTime @default(now())
  groupValidStart DateTime @default(now())

  GroupItem GroupItem[]
}

model GroupItem {
  transaction_id       String?
  transaction_draft_id String?
  transaction_group_id String
  seq                  String
  transaction          Transaction?      @relation(fields: [transaction_id], references: [id])
  transaction_draft    TransactionDraft? @relation(fields: [transaction_draft_id], references: [id])
  transaction_group    TransactionGroup  @relation(fields: [transaction_group_id], references: [id])

  @@unique([transaction_group_id, seq])
}

model Claim {
  id          String   @id @default(uuid())
  user_id     String
  claim_key   String
  claim_value String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  user        User     @relation(fields: [user_id], references: [id])

  @@unique([user_id, claim_key])
}

model Mnemonic {
  id           String   @id @default(uuid())
  user_id      String
  mnemonicHash String
  nickname     String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user         User     @relation(fields: [user_id], references: [id])
}

model PublicKeyMapping {
  id         String @id @default(uuid())
  public_key String @unique
  nickname   String
}

// The following models mirror the reviewer group schema from the organization
// backend (see #3184). They are a passive local cache of backend-authoritative
// rows, synced down rather than created locally, so their ids are the backend's
// own int PKs rather than locally-generated UUIDs — #3184 explicitly rejected
// UUIDs even for the backend ("doing it piecemeal adds ongoing cognitive
// overhead without a clear payoff"), so introducing them here, one hop removed,
// would just move that cost to the front-end while adding an id-translation
// layer that #3194's sync code would otherwise not need. `userId`, `userKeyId`,
// and `TransactionReviewerList.transactionId` reference the backend's int-PK
// `user`, `user_key`, and `transaction` tables — there is no local Prisma model
// for those, so they are plain scalar columns rather than relations.
// `transactionId` is NOT a FK to the front-end's own local `Transaction` model
// (which uses a String UUID `id` — a different id space entirely).
//
// `publicKey` is stored hex-encoded as a String, matching the back-end's own
// convention (GroupSnapshotMember.publicKey, this schema's PublicKeyMapping) rather
// than as Bytes.
//
// The client fully trusts the organization server for this data: a group/rule change
// only ever reaches the server's APPLIED state after it collects a real attestation
// threshold from the group's members, and the client does not re-verify that itself
// (see #3194 for the reasoning). So there is no local GroupChangeRecord/RuleChangeRecord
// history, no stored snapshot version, and no stored attestation — a sync just replaces
// each table's rows with whatever the server currently reports (shared/utils/reviewerSync.ts).
// `ReviewerGroupMember.publicKey` is still cached locally (not re-fetched live), because it's
// the trust anchor for a *different* mechanism — verifying a reviewer's own signature on a
// transaction review (see reviewerReviewService.ts) — which does need to work offline.
//
// Every reviewer table is scoped by `organizationId`: the int ids are per-backend, so two
// organizations can both have a group 1. Primary keys are therefore (organizationId, id),
// and deleting an Organization cascades to all of its reviewer data. A group member has no
// row id of its own (the back-end's own member rows carry none), so it is keyed by
// (organizationId, groupId, userId).
//
// Sync lives in #3194; see shared/utils/reviewerSync.ts.

model ReviewerGroup {
  organizationId String
  id             Int
  name           String
  description    String?
  threshold      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ReviewerGroupMember[]
  rules        ReviewerRule[]

  @@id([organizationId, id])
}

model ReviewerGroupMember {
  organizationId String
  groupId        Int
  userId         Int
  userKeyId      Int
  publicKey      String // hex-encoded; stored locally for signature verification
  createdAt      DateTime @default(now())

  group ReviewerGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, groupId, userId])
}

// Uniqueness on (organizationId, hederaId, network, groupId, entityRole, transactionType) cannot
// be expressed with @@unique, because SQLite (like other SQL engines) treats two NULLs
// as distinct, and Prisma's schema syntax has no way to express a functional/COALESCE
// index. The constraint is instead enforced by a hand-written unique index in the
// migration SQL, matching the COALESCE approach used by the back-end (#3184).
model ReviewerRule {
  organizationId  String
  id              Int
  groupId         Int
  hederaId        String
  network         String
  entityRole      String? // fee_payer | sender | receiver | account | file | token | topic | node; null matches any role. See EntityRole in the back-end's entity-role.enum.ts.
  transactionType String?
  condition       String? // reserved; JSON string; null until evaluation logic is built
  createdAt       DateTime @default(now())

  group ReviewerGroup @relation(fields: [organizationId, groupId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, id])
}

model TransactionReviewerList {
  id            Int      @id
  transactionId Int
  name          String?
  description   String?
  threshold     Int
  createdAt     DateTime @default(now())

  members TransactionReviewerListMember[]
}

model TransactionReviewerListMember {
  id         Int       @id
  listId     Int
  userId     Int
  userKeyId  Int?
  signature  Bytes?
  accepted   Boolean?
  note       String?
  actionedAt DateTime?
  createdAt  DateTime  @default(now())

  list TransactionReviewerList @relation(fields: [listId], references: [id])

  @@unique([listId, userId])
}
