{
  "name": "typeorm",
  "version": "0.43.0-beta.1",
  "private": true,
  "scripts": {
    "build": "tsc",
    "migration:run": "typeorm migration:run --dataSource ../dist/typeorm/data-source.js",
    "migration:revert": "typeorm migration:revert --dataSource ../dist/typeorm/data-source.js",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --config jest.config.mts",
    "test:cov": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --config jest.config.mts --coverage",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --config jest.config.mts --watch",
    "test:watch:cov": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules\" jest --config jest.config.mts --watch --coverage"
  },
  "dependencies": {
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "typeorm": "catalog:"
  },
  "devDependencies": {
    "@types/jest": "catalog:",
    "ioredis": "6.0.0",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:"
  }
}
