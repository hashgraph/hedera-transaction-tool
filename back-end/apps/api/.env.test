# Externally exposed port
HTTP_PORT=3000

# Internally exposed port
TCP_PORT=3001

# NATS Messaging URL
NATS_URL=nats://nats:4222

# JSON web token settings
JWT_SECRET=13123
# Temporary, expiration in days
JWT_EXPIRATION=365

# One time password settings
# OTP expiration in minutes - how long a code can be guessed against
OTP_EXPIRATION=2
# Number of failed verification attempts allowed before the OTP is locked out
OTP_MAX_ATTEMPTS=3
# How long, in minutes, the JWT issued after a successful OTP verification stays
# valid for setting the new password
OTP_VERIFIED_EXPIRATION=5

# Throttler limits
ANONYMOUS_MINUTE_LIMIT=9999
ANONYMOUS_FIVE_SECOND_LIMIT=99999
GLOBAL_MINUTE_LIMIT=9999
GLOBAL_SECOND_LIMIT=99999
USER_MINUTE_LIMIT=9999
USER_SECOND_LIMIT=99999

# Postgres database
POSTGRES_SYNCHRONIZE=false
POSTGRES_MAX_POOL_SIZE=2

# Frontend version control (optional)
LATEST_SUPPORTED_FRONTEND_VERSION=0.21.0
MINIMUM_SUPPORTED_FRONTEND_VERSION=0.21.0
FRONTEND_REPO_URL=https://github.com/hashgraph/hedera-transaction-tool/releases