# Externally exposed port
HTTP_PORT=3000

# Internally exposed port
TCP_PORT=3001

# NATS Messaging URI
NATS_URL=nats://nats:4222

# JSON web token settings
JWT_SECRET=some-very-secret-string
# Temporary, expiration in days
JWT_EXPIRATION=365

# One time password settings
# OTP expiration in minutes - how long a code can be guessed against
OTP_EXPIRATION=2
# Number of failed verification attempts allowed before the OTP is locked out
OTP_MAX_ATTEMPTS=3
# How long, in minutes, the JWT issued after a successful OTP verification stays
# valid for setting the new password
OTP_VERIFIED_EXPIRATION=5

# Format of REDIS_URL:
# redis[s]://[[username][:password]@][host][:port][/db-number]
REDIS_URL=redis://redis:6379
REDIS_DEFAULT_TTL_MS=60000

# Throttler limits
ANONYMOUS_MINUTE_LIMIT=3
ANONYMOUS_FIVE_SECOND_LIMIT=1
GLOBAL_MINUTE_LIMIT=10000
GLOBAL_SECOND_LIMIT=1000
USER_MINUTE_LIMIT=100
USER_SECOND_LIMIT=10

# IP-based throttler limits (shared across all users behind the same IP)
LOGIN_IP_MINUTE_LIMIT=20
LOGIN_IP_TEN_SECOND_LIMIT=5
# RESET_IP_* also gates /verify-reset, not just /reset-password - each route tracks
# its own count under these same limits (see IpResetPasswordThrottlerGuard).
RESET_IP_MINUTE_LIMIT=5
RESET_IP_TEN_SECOND_LIMIT=1
# Also shared with /verify-reset (see IpUniqueEmailGuard) - one counter for how many
# distinct emails an IP has touched across the whole reset flow, not one per route.
RESET_IP_UNIQUE_EMAIL_LIMIT=3

# Which edge/CDN provider's header convention IpResolverService should trust to
# resolve the real client IP (see libs/common/src/ip-resolution). Only "cloudflare"
# (CF-Connecting-IP) is implemented today; it's also the default if unset. Add a new
# IpResolutionStrategy + a case in IpResolverService's constructor if a second provider
# is ever needed. Only trustworthy once the origin is unreachable except through
# Cloudflare (mTLS between Cloudflare and Traefik, configured separately in infra).
# IP_TRUST_PROVIDER=cloudflare

# Postgres database
# service name for postgres service in docker
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MAX_POOL_SIZE=2
# should be false in production
POSTGRES_SYNCHRONIZE=false

# PG Admin settings
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=pgadmin4

# Select one of the follow: production/development. Default: development
NODE_ENV=development

# Frontend version control (optional)
LATEST_SUPPORTED_FRONTEND_VERSION=0.24.0
MINIMUM_SUPPORTED_FRONTEND_VERSION=0.23.0
FRONTEND_REPO_URL=https://github.com/hashgraph/hedera-transaction-tool/releases
